DATABASE_URL=sqlite:///./nick_job_agent.db
CORS_ORIGINS=http://localhost:3000
HTTP_TIMEOUT_SECONDS=20
CONNECTOR_USER_AGENT=NickJobAgent/0.1 (personal job discovery)
SOURCE_SCAN_FREQUENCY_DEFAULT=manual
SCORING_ROLE_WEIGHT=0.20
SCORING_DOMAIN_WEIGHT=0.20
SCORING_SKILLS_WEIGHT=0.15
SCORING_EXPERIENCE_WEIGHT=0.15
SCORING_RESEARCH_WEIGHT=0.15
SCORING_SENIORITY_WEIGHT=0.05
SCORING_LOCATION_WEIGHT=0.05
SCORING_COMPENSATION_WEIGHT=0.05
RECOMMENDATION_EXCEPTIONAL_MIN=90
RECOMMENDATION_STRONG_MIN=80
RECOMMENDATION_POSSIBLE_MIN=70
RECOMMENDATION_WEAK_MIN=55

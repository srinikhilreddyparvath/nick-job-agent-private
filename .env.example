# Docker Compose environment. Copy this file to .env in the repository root.
# Replace the local database password. Enable an AI provider only if wanted.
# Résumé text and candidate evidence may be sent to that configured provider.
# Never commit .env or real secrets.
POSTGRES_PASSWORD=replace-with-a-local-password

LLM_ENABLED=false
# Required only when LLM_ENABLED=true.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
OPENAI_API_KEY=

APPLICATION_MODE=manual
AUTO_SUBMIT_ENABLED=false
RESUME_EXTRACTION_MAX_TOKENS=6000
RESUME_EXTRACTION_TIMEOUT_SECONDS=90
DISCOVERY_MAX_SOURCES_PER_RUN=20
DASHBOARD_MAX_JOBS_PER_COMPANY=3
DEMO_MODE=false
CONTACT_DISCOVERY_MAX_PAGES_PER_JOB=10
CONTACT_DISCOVERY_MAX_CONTACTS=5
CONTACT_DISCOVERY_TIMEOUT_SECONDS=10
CONTACT_DISCOVERY_FRESHNESS_HOURS=168
CONTACT_DISCOVERY_MIN_RELEVANCE_SCORE=28
CONTACT_DISCOVERY_BROWSER_FALLBACK_ENABLED=true
CONTACT_DISCOVERY_BROWSER_MAX_PAGES=3
CONTACT_DISCOVERY_BROWSER_TIMEOUT_SECONDS=15
AUTO_APPLY_PAUSED=false

CANDIDATE_PROFILE_PATH=../data/profile.local.json
CANDIDATE_PREFERENCES_PATH=../data/preferences.local.json
CANDIDATE_EVIDENCE_PATH=../data/evidence.local.json
CANDIDATE_ANSWER_BANK_PATH=../data/answer_bank.local.json
CANDIDATE_APPLICATION_POLICY_PATH=../data/application_policy.local.json
CANDIDATE_PRIVATE_STORAGE_PATH=../data/private
RESUME_MAX_UPLOAD_BYTES=10485760

# Candidate data belongs only in ignored *.local.json files copied from data/*.example.json.
